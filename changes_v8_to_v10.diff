+# How deep below CIN_FOLDER_PATH a CIN folder / archive is searched for (a full recursive search of a large
+# storage tree can take minutes per CIN). Layouts seen: <root>/<CIN>, <root>/<group>/<CIN>, <root>/<a>/<b>/<CIN>.
+CIN_SEARCH_DEPTH = int(os.environ.get("CIN_SEARCH_DEPTH", "3") or 3)
+
+
+def _walk(root: Path, depth: int):
+    """Every path below root, at most `depth` levels down (breadth first, unreadable folders skipped)."""
+    level = [root]
+    for _ in range(max(depth, 0)):
+        nxt = []
+        for d in level:
+            try:
+                kids = list(d.iterdir())
+            except OSError:
+                continue
+            for k in kids:
+                yield k
+                if k.is_dir():
+                    nxt.append(k)
+        level = nxt
+
+
+def _find_dir_named(root: Path, name_upper: str, depth: int) -> Optional[Path]:
+    for p in _walk(root, depth):
+        if p.is_dir() and p.name.upper() == name_upper:
+            return p
+    return None
+
