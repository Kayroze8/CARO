+# ===========================================================================
+# RULE TABLE_ABSOLUTE (v10, Toby 15-Oct-2026): every row of disputed_dues_table shows its amount in absolute
+# rupees, the same way amount_total does. Example (Apollo 2024-25 (vii)): the auditor prints "22.95*" and
+# "185.59*" under "(Rs. in lakhs)" -> 2295000.0 and 18559000.0 (amount_total 20854000.0).
+# How a row's figure is converted, first match wins:
+#   1. the same printed figure was already converted for amount_total (amount_calc items of the unit or of its
+#      sub-clauses) -> that value, so the rows always agree with amount_total;
+#   2. a unit printed in the cell ("12.5 lakh") or a figure written in full rupees ("15,410/-", "1,00,65,542");
+#   3. the unit heading of the table the figure is printed in ("(Rs. in lakhs)"), or a unit word right after it;
+#   4. a whole number with no heading anywhere -> rupees as printed.
+# A decimal figure whose unit cannot be found is NOT guessed: the row keeps the auditor's text and the unit is
+# sent for review (review reason table_amount_unit_unclear) - the same rule as amount_total (F15).
+# Runs after apply_amounts; nothing reads the row text after this point. Switch: AMOUNT_SWITCHES["TABLE_ABSOLUTE"].
+# ===========================================================================
+_PERIOD = re.compile(r"(?:19|20)\d{2}\s*[-–/]\s*(?:19|20)?\d{2}\b|\b(?:jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\.?\s*,?\s*"
+                     r"(?:19|20)\d{2}\b|\b(?:AY|A\.Y\.?|FY|F\.Y\.?|assessment\s+year|financial\s+year)\s*(?:19|20)\d{2}(?:\s*[-–/]\s*(?:19|20)?\d{2})?", re.I)
+
+
+def _money_figures(cell: str) -> list:
+    """The money figures printed in one table cell: periods ("2011-12", "AY 2018-19", "November 2014") and bare
+    years are not money. "Rs. 20,95,74,867 and Rs. 1,00,65,542" -> two figures."""
+    t = _PERIOD.sub(" ", str(cell))
+    out = []
+    for m in _FIG.finditer(t):
+        n = m.group("num").replace(",", "")
+        if re.fullmatch(r"(?:19|20)\d\d", n) and not (m.group("cur") or m.group("unit") or m.group("dash")):
+            continue
+        out.append(m.group(0).strip())
+    return out
+
+
+def _one_figure(printed, pool: list, quote: str, full_text: str):
+    m = _FIG.search(str(printed))
+    if not m:
+        return None
+    num = m.group("num").replace(",", "")
+    for p, v in pool:                                            # 1. same figure as amount_total used
+        mm = _FIG.search(str(p or ""))
+        if mm and v and mm.group("num").replace(",", "") == num:
+            return float(v)
+    nm = m.group("num")
+    if m.group("unit") or m.group("dash") or (nm.count(",") >= 2 and "." not in nm) or (m.group("cur") and "." not in nm):
+        return to_rupees(printed, 1.0)                           # 2. unit in the cell / full rupees
+    pos = locate_figure(printed, quote, full_text) if full_text else -1
+    mult = inline_unit(full_text, pos, m.group("num")) if pos >= 0 else None
+    if not mult and full_text:
+        mult = _heading_for_figure(printed, quote, full_text, _WINDOW, pos)
+    if mult and mult != 1.0:
+        return to_rupees(printed, mult)                          # 3. table heading / unit word
+    if "." not in nm:
+        return to_rupees(printed, 1.0)                           # 4. whole number, no heading: rupees
+    return None
+
+
+def _row_rupees(cell, pool: list, quote: str, full_text: str):
+    """Absolute rupees for one cell (several figures in one cell are added), or None when any figure's unit is
+    unclear or the cell holds no money figure."""
+    figs = _money_figures(cell)
+    if not figs:
+        return None
+    vals = [_one_figure(f, pool, quote, full_text) for f in figs]
+    if any(v is None for v in vals):
+        return None
+    return sum(vals)
+
+
+def absolute_table_amounts(records: list, caro_text: Optional[str]) -> dict:
+    """Convert disputed_dues_table[].amount to absolute rupees (see the block comment above). Never raises."""
+    out = {"converted": 0, "unclear": 0}
+    if not amt_switch_on("TABLE_ABSOLUTE"):
+        return out
+    text = caro_text or ""
+
+    def items(rec):
+        return [(i.get("as_printed"), i.get("rupees")) for i in ((rec or {}).get("amount_calc") or {}).get("items") or []]
+    for r in records or []:
+        if not isinstance(r, dict):
+            continue
+        subs = [x for x in (r.get("sub_clauses") or []) if isinstance(x, dict)]
+        sub_pool = [it for x in subs for it in items(x)]
+        for rec in [r] + subs:
+            try:
+                nf = rec.get("normalized_fields") if isinstance(rec.get("normalized_fields"), dict) else {}
+                rows = nf.get("disputed_dues_table") or []
+                if not rows:
+                    continue
+                pool = items(rec) + (sub_pool if rec is r else items(r))
+                quote = str(nf.get("source_text") or rec.get("evidence_text") or "")
+                unclear = []
+                for row in rows:
+                    if not isinstance(row, dict):
+                        continue
+                    a = row.get("amount")
+                    if a is None or isinstance(a, bool) or isinstance(a, (int, float)):
+                        continue
+                    if re.fullmatch(r"\s*(?:-+|–|nil|none|n\.?a\.?|not\s+applicable)?\s*\.?\s*", str(a), re.I):
+                        continue                                  # "-", "Nil", "": nothing to convert
+                    v = _row_rupees(a, pool, quote, text)
+                    if v is None:
+                        unclear.append(str(a))
+                        continue
+                    row["amount"] = round(float(v), 2)
+                    out["converted"] += 1
+                if unclear:
+                    out["unclear"] += len(unclear)
+                    rr = rec.setdefault("review_reasons", [])
+                    if "table_amount_unit_unclear" not in rr:
+                        rr.append("table_amount_unit_unclear")
+                    rec["table_amount_unclear"] = unclear[:10]
+            except Exception:                                     # noqa: BLE001 -- never break a filing
+                continue
+    return out
