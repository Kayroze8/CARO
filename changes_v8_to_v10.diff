+# ---------------------------------------------------------------------------
+# Output folders (production: everything except the API log and the results is OFF)
+# ---------------------------------------------------------------------------
+# One switch per optional output. Unset = OFF. CARO_SAVE_ALL=true turns every one on (local debugging
+# reruns); CARO_WRITE_FILES=false is the old master switch and still turns every one off.
+SAVE_SWITCHES = {
+    "xml_output": "CARO_SAVE_XML_OUTPUT",          # xml_caro_output/ (clauses/, manifest)
+    "extracted_text": "CARO_SAVE_EXTRACTED_TEXT",  # logs/extracted_text/   (CARO text sent to the model)
+    "llm_replies": "CARO_SAVE_LLM_REPLIES",        # logs/extracted_llm_out/ (raw model replies)
+    "audit": "CARO_SAVE_AUDIT",                    # logs/caro_audit/        (what each rule changed and why)
+    "perf": "CARO_SAVE_PERF",                      # logs/perf/              (timing workbook)
+    "fy_tracking": "CARO_SAVE_FY_TRACKING",        # <CARO_XML_OUTPUT_DIR>/fy_tracking.csv
+    "cin_logs": "CARO_SAVE_CIN_LOGS",              # logs/cin/               (one detailed log per CIN)
+}
+
+
+def save_enabled(kind: str) -> bool:
+    """True when the optional output ``kind`` (a key of SAVE_SWITCHES) should be written to disk."""
+    master = os.environ.get("CARO_WRITE_FILES")
+    if master is not None and master.strip().lower() in ("false", "0", "no", "off"):
+        return False
+    if _env_bool("CARO_SAVE_ALL", False):
+        return True
+    return _env_bool(SAVE_SWITCHES[kind], False)
+
+
+# ---------------------------------------------------------------------------
+# Summary logging (LOG_STYLE)
+# ---------------------------------------------------------------------------
+# LOG_STYLE=summary (default): the terminal and the API log show only the short per-CIN summary
+#   (logger "caro.summary") and errors. Warnings are counted per CIN and the count is shown in the summary.
+# LOG_STYLE=detailed: every INFO / WARNING line, as before (use it when investigating a problem).
+SUMMARY_LOGGER = "caro.summary"
+_warn_local = threading.local()
+
+
+def log_style() -> str:
+    v = (os.environ.get("LOG_STYLE") or "summary").strip().lower()
+    return v if v in ("summary", "detailed") else "summary"
+
+
+class _SummaryOnly(logging.Filter):
+    def filter(self, record: logging.LogRecord) -> bool:
+        return record.name.startswith(SUMMARY_LOGGER) or record.levelno >= logging.ERROR
+
+
+class _WarningCounter(logging.Handler):
+    """Counts WARNING records of the current thread (shown as 'warnings: N' in the CIN summary)."""
+    def emit(self, record: logging.LogRecord) -> None:
+        if record.levelno == logging.WARNING and not record.name.startswith(SUMMARY_LOGGER):
+            _warn_local.count = getattr(_warn_local, "count", 0) + 1
+
+
+def warnings_reset() -> None:
+    _warn_local.count = 0
+
+
+def warnings_count() -> int:
+    return getattr(_warn_local, "count", 0)
+
+
