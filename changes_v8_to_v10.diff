+def post_json(req: "urllib.request.Request", timeout: float, client: Any = None) -> dict:
+    """Send one request to the model server and return the decoded JSON reply.
+
+    A SERVER problem (cannot connect, timeout, HTTP 5xx, HTTP 429) is retried LLM_SERVER_RETRIES times (default 1)
+    after LLM_SERVER_RETRY_WAIT_S seconds (default 30). The request is byte-identical and the model runs at
+    temperature 0, so a retry cannot change a label. A problem with the ANSWER (bad JSON, cut-off reply) is not
+    handled here -- the two-call flow has its own handling for that. Every retry is shown in the summary log.
+    """
+    retries = max(0, int(os.environ.get("LLM_SERVER_RETRIES", "1") or 0))
+    wait = float(os.environ.get("LLM_SERVER_RETRY_WAIT_S", "30") or 0)
+    for attempt in range(retries + 1):
+        if client is not None:
+            client.calls = getattr(client, "calls", 0) + 1
+        try:
+            with urllib.request.urlopen(req, timeout=timeout) as r:
+                return json.loads(r.read())
+        except urllib.error.HTTPError as e:
+            if not (e.code >= 500 or e.code == 429) or attempt == retries:
+                raise
+            why = f"HTTP {e.code}"
+        except (urllib.error.URLError, socket.timeout, TimeoutError, ConnectionError) as e:
+            if attempt == retries:
+                raise
+            why = f"{type(e).__name__}: {getattr(e, 'reason', e)}"
+        if client is not None:
+            client.server_retries = getattr(client, "server_retries", 0) + 1
+        _summary.warning("  model server error (%s) - retrying in %.0f s", why, wait)
+        time.sleep(wait)
+    raise RuntimeError("unreachable")
 
