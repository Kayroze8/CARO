+# ---------------------------------------------------------------------------
+# PATCH 13-Oct-2026 (Phase 2, amounts) -- checks on the model's figures, two-call records only.
+# amount no longer depends on which cells of a table the model happened to copy.
+#
+# WHY (13-Oct run, CA review of every one of the 162 amounts; 34 wrong):
+#   * a "deposited under protest" column added to the disputed dues (Aditya 2020-21 (vii)(b));
+#   * a previous-year column picked where this year's cell is 0.00 (Western 2020-21 (v));
+#   * opening balance / amount given during the year added to the year-end balance (Garden Court
+#     2024-25 (iii)(a)(A), Western 2023-24 (iii), K.R. Foods 2020-21 (iii)(b), Ichalkaranji (v));
+#   * a loan balance shown as the default amount (Viraj Canes (ix)(a), 5 years);
+#   * the Rs 5 crore limit of (ii)(b) shown as an amount (Refit 2023-24);
+#   * "110 acre" counted as Rs 110 (Shri Dutt (i)(c));
+#   * interest that is already inside the outstanding figure added again (Ichalkaranji (ix)(a));
+#   * undisputed arrears added to the disputed dues (Apollo 2020-21 (vii)(b));
+#   * (iii)(a) table rows put on the wrong slot (WickedRide, 4 years) and a guarantee added to a loan
+#     (Shri Dutt 2023-24 (iii)(a)(B)) - the approved rule LOAN VS. GUARANTEE says the funded loan
+#     balance is the amount and a guarantee is never added to it;
+#   * (ii)(b) quarterly differences added together or not read at all.
+#
+# Every check here only REMOVES a figure that cannot count, ADDS a row of the same table column the
+# model already used, or reads a table the auditor printed for (iii)(a) / (ii)(b). No label is ever
+# set. All checks run only on two-call records (record carries "staged_trace"); the single flow is
+# untouched. Each check can be switched off in AMOUNT_SWITCHES (rollback without a code change).
+# ---------------------------------------------------------------------------
+AMOUNT_SWITCHES = {
+    "TABLE_COLUMNS": True,   # paid / opening / previous-year / flow columns never count; closing column of loan tables
+    "ROW_COMPLETE": True,    # rows of the same table column the model left out (loan / deposit tables)
+    "III_A_TABLE": True,     # (iii)(a)(A)/(B) amounts read from the auditor's table by row label
+    "II_B_DIFF": True,       # (ii)(b): the difference, year-end quarter (else the largest); never a sum
+    "NOT_MONEY": True,       # areas, the Rs 5 crore limit of (ii)(b)
+    "BALANCE_NOT_DEFAULT": True,  # (ix)(a) / CARO 2016 (viii): a loan balance is not a default amount
+    "UNDISPUTED_IN_VII_B": True,  # undisputed arrears never count under (vii)(b); move to (vii)(a)
+    "INTEREST_TEXT": True,   # "outstanding ... including interest" also on the text-reading path
+    "UNIT_CARRY": True,      # "Rs.1009 thousand and ... Rs.9563": the bare figure takes the unit
+    "OPENING_PROSE": True,   # "outstanding at the beginning of the year was ..." never counts
+    "FAV_NO_AMOUNT": True,   # a Favourable unit carries an amount only for exposure units
+    "SIBLING_DUP": True,     # one printed figure on one sub-clause only ((xx)(a)/(b), (iii)(a)(A)/(B))
+    "EVIDENCE_SHOWS_AMOUNT": False, # source_text gets the table row / sentence of a counted figure (off: needs placement fix first)
+    "OWN_CLAUSE_ONLY": True,  # a figure must be printed in this clause's own passage (not another clause's)
+}
+
+
+def amt_switch_on(key: str) -> bool:
+    return bool(AMOUNT_SWITCHES.get(key, False))
+
+
+def is_staged(rec: dict) -> bool:
+    return isinstance(rec, dict) and rec.get("staged_trace") is not None
+
+
+# ---------------------------------------------------------------------------
+# units
+# ---------------------------------------------------------------------------
+LOANISH = {2020: {"iii", "iii_a", "iii_a_a", "iii_a_b", "iii_b", "iii_c", "iii_d", "iii_e", "iii_f", "v"},
+           2016: {"iii", "iii_a", "iii_b", "iii_c", "v"}}
+# Favourable units whose amount is an exposure worth showing (loans / guarantees given, deposits)
+EXPOSURE = {2020: {"iii", "iii_a_a", "iii_a_b", "iii_f", "iv", "v"},
+            2016: {"iii", "iii_a", "iv", "v"}}
+DEFAULT_UNITS = {2020: {"ix_a"}, 2016: {"viii"}}
+
+# ---------------------------------------------------------------------------
+# table reader (the CARO text keeps one table cell per line; a few lines hold two figures)
+# ---------------------------------------------------------------------------
+_NUMTOK = re.compile(r"(?:(?:rs\.?|₹|inr|\?)\s*)?(\d[\d,]*(?:\.\d+)?)\s*(?:/-)?\s*(?:\(\s*(?:dr|cr)\.?\s*\))?", re.I)
+_EMPTY_CELL = re.compile(r"^\s*(?:-+|–|—|nil|n\.?a\.?|none)\s*$", re.I)
+_MAINMARK = re.compile(r"(?m)^[ \t]*\(?\s*[ivx]{1,5}\s*[.)][ \t]|\[MCA_BOX:")
+_SUBMARK = re.compile(r"(?m)^[ \t]*\(?\s*[a-h]\s*\)[ \t]?\S|^[ \t]*\(?\s*[ivx]{1,5}\s*\)\s*\(\s*[a-h]\s*\)")
+_INTRO = re.compile(r"as follows|as under|here\s*under|given below|mentioned below|details below|[:]\s*$", re.I)
+_UNIT_LINE = re.compile(r"^\s*\(?\s*(?:amount\s*)?(?:\(?\s*(?:rs\.?|₹|inr|rupees)\s*\)?\s*)?(?:in\s+)?"
+                        r"(?:rupees\s+)?(?:crores?|lakhs?|lacs?|thousands?|rs\.?|₹|inr)?\s*\)?\s*$", re.I)
+_DATE = re.compile(r"\b\d{1,2}[./-]\d{1,2}[./-]((?:19|20)\d\d)\b|\b31(?:st)?\s*(?:march|mar\.?),?\s*((?:19|20)\d\d)\b", re.I)
+_MONEYCOL = re.compile(r"amount|balance|disput|protest|deposit|paid|given|granted|during the year|opening|closing"
+                       r"|outstanding|guarantee|loan|advance|investment|security|difference|value as per|\bin\s+rs\b|\(\s*in\s+rs", re.I)
+_NOT_AMOUNT_COL = re.compile(r"^\s*(?:period|forum|nature of|name of|statute|particulars|pan\b|quarter|due date|date of"
+                             r"|s\.?\s*no|sr\.?\s*no|reason|remarks?)", re.I)
+_SLOT_A = re.compile(r"subsidiar|joint\s*venture|\bjvs?\b|associate(?!d)(?!\s+concern)", re.I)
+_SLOT_B = re.compile(r"\bothers?\b|employees?|any other part|other than", re.I)
+_GROUP_FLOW = re.compile(r"aggregate amount|during the year|granted|provided during", re.I)
+_GROUP_STOCK = re.compile(r"balance outstanding|outstanding as at|balance as at|closing balance", re.I)
+
+
+def _col_kind(h: str) -> str:
+    s = h.lower()
+    if re.search(r"protest|deposited|\bpaid\b|pre-?deposit", s):
+        return "paid"
+    if re.search(r"opening|beginning|brought forward", s):
+        return "opening"
+    if "difference" in s:
+        return "difference"
+    if re.search(r"as per books|books of account", s):
+        return "books"
+    if re.search(r"statement|returns?\b|lenders|bank", s) and "value" in s:
+        return "statement"
+    if "guarantee" in s or re.search(r"\bsecurity\b", s):
+        return "guarantee"
+    if re.search(r"during the year|given|granted|aggregate amount", s) and not re.search(r"closing|balance|outstanding", s):
+        return "flow"
+    if re.search(r"closing|balance|outstanding", s):
+        return "stock"
+    if re.search(r"\bloans?\b|advance", s):
+        return "loan"
+    return "main"
+
+
+def _lines(text: str, start: int, end: int):
+    """[(abs_start, abs_end, stripped line)] for non-empty lines."""
+    out = []
+    pos = start
+    for raw in text[start:end].split("\n"):
+        s = raw.strip()
+        if s:
+            out.append((pos, pos + len(raw), s))
+        pos += len(raw) + 1
+    return out
+
+
+def _cells_of(line: str, abs_start: int):
+    """Cells of a line made only of figures / '-' (None when the line has words)."""
+    if _EMPTY_CELL.match(line):
+        return [("-", abs_start, None)]
+    rest = re.sub(r"\(\s*(?:dr|cr)\.?\s*\)", "", line, flags=re.I)
+    rest = re.sub(r"(?:rs\.?|₹|inr|/-|\?)", "", rest, flags=re.I)
+    if re.search(r"[A-Za-z]", rest):
+        return None
+    toks = list(_NUMTOK.finditer(line))
+    if not toks:
+        return None
+    # a lone integer below 1,000 with no comma / decimal is a serial number, not a cell
+    if len(toks) == 1:
+        n = toks[0].group(1)
+        if "," not in n and "." not in n and len(n) <= 3:
+            return None
+        if re.fullmatch(r"(?:19|20)\d\d", n):
+            return None
+    # every character must be a figure, '-', space or marker
+    left = _NUMTOK.sub("", line)
+    left = re.sub(r"[\s\-–—]+", "", left)
+    if left:
+        return None
+    out = []
+    for m in toks:
+        out.append((m.group(0).strip(), abs_start + m.start(1), m.group(1)))
+    return out
+
+
+def _region(text: str, pos: int):
+    """Start / end of the table region around pos: no further back than the clause (or sub-clause)
+    marker before pos, no further on than the next marker / running sentence."""
+    start = max(0, pos - 4000)
+    for m in _MAINMARK.finditer(text, start, pos):
+        start = m.start()
+    end = len(text)
+    nxt = _MAINMARK.search(text, pos + 1)
+    if nxt:
+        end = nxt.start()
+    return start, min(end, pos + 8000)
+
+
+def _header_and_rows(text: str, pos: int):
+    """Read the table that holds pos. Returns dict(header=[...], kinds=[...], rows=[...], intro=str,
+    slot_table=bool, lines=[...]) or None."""
+    start, end = _region(text, pos)
+    lines = _lines(text, start, end)
+    if not lines:
+        return None
+    idx = next((i for i, (a, b, _) in enumerate(lines) if a <= pos <= b), None)
+    if idx is None:
+        return None
+    if _cells_of(lines[idx][2], lines[idx][0]) is None:
+        return None
+    # walk back to the start of the table: the introducing sentence
+    j = idx
+    first_cell = None
+    while j >= 0:
+        s = lines[j][2]
+        words = len(re.findall(r"[A-Za-z]{2,}", s))
+        cells = _cells_of(s, lines[j][0])
+        if cells is not None:
+            first_cell = j
+        elif words >= 10 or (words >= 4 and _INTRO.search(s)):
+            break
+        j -= 1
+    intro = lines[j][2] if j >= 0 else ""
+    hdr_start = j + 1
+    if first_cell is None:
+        return None
+    # the table ends at the first running sentence after pos
+    k = idx
+    while k + 1 < len(lines):
+        s = lines[k + 1][2]
+        if _cells_of(s, lines[k + 1][0]) is None and len(re.findall(r"[A-Za-z]{2,}", s)) >= 10:
+            break
+        k += 1
+    body = lines[hdr_start:k + 1]
+    # header = label lines before the first cell line
+    pre = []
+    for a, b, s in body:
+        if _cells_of(s, a) is not None:
+            break
+        pre.append(s)
+    slot_table = False
+    header = []
+    for s in pre:
+        if (_GROUP_FLOW.search(s) or _GROUP_STOCK.search(s)) and len(re.findall(r"[A-Za-z]{2,}", s)) >= 4 \
+                and not re.search(r"closing|opening|\(\s*in\s+rs|31[./]|value as per|amount of", s, re.I):
+            slot_table = True                      # a row-group label ("Balance outstanding as at ..."), not a column
+            break
+        if (_SLOT_A.search(s) or _SLOT_B.search(s)) and len(re.findall(r"[A-Za-z]{2,}", s)) <= 6:
+            slot_table = True                      # a row label ("- Subsidiaries"), not a column
+            break
+        if re.fullmatch(r"\(?\s*(?:rs\.?|₹|inr)\s*\.?\s*\)?", s, re.I) or _UNIT_LINE.match(s) and len(s) < 30 \
+                and not re.match(r"amount\b", s, re.I) \
+                and not re.search(r"[A-Za-z]{4,}", re.sub(r"(?i)crores?|lakhs?|lacs?|thousands?|amount|rupees", "", s)):
+            if header and len(s) < 12:
+                header[-1] += " " + s              # "(Rs.)" under "Amount Disputed"
+            continue
+        if header and s.lower() in ("balance", "balances", "amount", "(rs)", "(rs.)") :
+            header[-1] += " " + s                  # "Closing" / "Balance" on two lines
+            continue
+        header.append(s)
+    money = [h for h in header if _MONEYCOL.search(h) and not _NOT_AMOUNT_COL.search(h)]
+    kinds = [_col_kind(h) for h in money]
+    # dates decide current / previous between columns of the same kind
+    years = []
+    for h in money:
+        m = _DATE.search(h)
+        years.append(int(m.group(1) or m.group(2)) if m else None)
+    if sum(1 for y in years if y) >= 2:
+        latest = max(y for y in years if y)
+        kinds = [("prior" if (y and y < latest) else k) for k, y in zip(kinds, years)]
+    # rows: label lines then a run of cells
+    rows, cur_label, run = [], [], []
+    for a, b, s in body[len(pre):]:
+        cells = _cells_of(s, a)
+        if cells is None:
+            if run:
+                rows.append({"label": " ".join(cur_label), "cells": run})
+                cur_label, run = [], []
+            cur_label.append(s)
+        else:
+            run.extend(cells)
+    if run:
+        rows.append({"label": " ".join(cur_label), "cells": run})
+    return {"header": money, "kinds": kinds, "rows": rows, "intro": intro, "pre": pre,
+            "slot_table": slot_table, "start": lines[hdr_start][0] if hdr_start < len(lines) else start}
+
+
+def cell_kind(text: str, pos: int) -> Optional[str]:
+    """Kind of the table column the figure at pos sits in, or None when the table cannot be read
+    safely. Kinds: paid, opening, prior, flow, stock, guarantee, loan, difference, books, statement,
+    main, closing_last / not_last (closing column is the last one and the row has more cells)."""
+    t = _header_and_rows(text, pos)
+    if not t or t["slot_table"] or len(t["header"]) < 2:
+        return None
+    for r in t["rows"]:
+        for i, c in enumerate(r["cells"]):
+            if c[2] and c[1] <= pos < c[1] + len(c[2]):
+                n = len(r["cells"])
+                if n == len(t["kinds"]):
+                    return t["kinds"][i]
+                if t["kinds"][-1] in ("stock",) and n > len(t["kinds"]):
+                    return "stock" if i == n - 1 else "not_last"
+                return None
+    return None
+
+
+def table_column_cells(text: str, pos: int):
+    """All cells (printed, position) of the column the figure at pos sits in, when every row has the
+    same number of cells as the header has amount columns; None otherwise."""
+    t = _header_and_rows(text, pos)
+    if not t or t["slot_table"] or len(t["header"]) < 2:
+        return None
+    n = len(t["kinds"])
+    if any(len(r["cells"]) != n for r in t["rows"]):
+        return None
+    col = None
+    for r in t["rows"]:
+        for i, c in enumerate(r["cells"]):
+            if c[2] and c[1] == pos:
+                col = i
+    if col is None:
+        return None
+    return [(r["cells"][col][0], r["cells"][col][1], r["label"]) for r in t["rows"] if r["cells"][col][2]]
+
+
+# ---------------------------------------------------------------------------
+# (iii)(a) table by row label
+# ---------------------------------------------------------------------------
+def _num(s: str) -> Optional[float]:
+    m = re.search(r"\d[\d,]*(?:\.\d+)?", s or "")
+    if not m:
+        return None
+    try:
+        return float(m.group(0).replace(",", ""))
+    except ValueError:
+        return None
+
+
+def iii_a_slot_figures(window: str, slot: str):
+    """(iii)(a) amounts table read by row label. slot 'A' (subsidiaries / JV / associates) or 'B'
+    (others). Returns (list of printed cells that count, note) or None when no such table is found or
+    it cannot be read safely. Balance outstanding row only (FLOW VS. STOCK); funded loans / advances
+    when printed, guarantees only when no loan is printed (LOAN VS. GUARANTEE)."""
+    if not window:
+        return None
+    lines = _lines(window, 0, len(window))
+    # find a header: two or more amount-kind column names among Guarantees / Loans / Advances / Security
+    hdr_idx = [i for i, (_, _, s) in enumerate(lines)
+               if re.fullmatch(r"(?:-\s*)?(?:corporate\s+)?(?:guarantees?|loans?|advances?(?: in (?:the )?nature of loans?)?|security|securities"
+                               r"|investments?)\.?", s, re.I)]
+    if len(hdr_idx) < 2:
+        return None
+    first = hdr_idx[0]
+    # the columns must be consecutive lines (a header block)
+    cols = []
+    for i in range(first, len(lines)):
+        s = lines[i][2]
+        if i in hdr_idx:
+            cols.append("guarantee" if re.search(r"guarantee|security", s, re.I) else "loan")
+        elif re.fullmatch(r"particulars", s, re.I) or _UNIT_LINE.match(s) and len(s) < 30:
+            continue
+        else:
+            break
+    if len(cols) < 2:
+        return None
+    nc = len(cols)
+    intro = " ".join(s for _, _, s in lines[max(0, first - 3):first])
+    # tokens after the header
+    toks = []
+    for a, b, s in lines[first + len(cols):]:
+        cells = _cells_of(s, a)
+        if cells is not None:
+            toks.extend(("C", c) for c in cells)
+            continue
+        words = len(re.findall(r"[A-Za-z]{2,}", s))
+        if _GROUP_STOCK.search(s) or re.search(r"\bbalance\b", s, re.I):
+            toks.append(("G", "stock"))
+        elif _GROUP_FLOW.search(s):
+            toks.append(("G", "flow"))
+        elif _SLOT_A.search(s) and words <= 6:
+            toks.append(("L", "A"))
+        elif _SLOT_B.search(s) and words <= 6:
+            toks.append(("L", "B"))
+        elif words >= 10:
+            break                                  # running sentence: end of table
+        else:
+            continue                               # "of above", "in respect" ...
+    # the balance-outstanding group
+    try:
+        g = max(i for i, t in enumerate(toks) if t == ("G", "stock"))
+    except ValueError:
+        return None
+    seg = []
+    for t in toks[g + 1:]:
+        if t[0] == "G":
+            break
+        seg.append(t)
+    # the cells printed between the group label and its first slot label belong to the group too
+    labels = [t[1] for t in seg if t[0] == "L"]
+    blocks, cur = [], []
+    order = []                                     # sequence of 'L:x' / 'B:i'
+    for t in seg:
+        if t[0] == "C":
+            cur.append(t[1])
+        else:
+            if cur:
+                blocks.append(cur)
+                order.append(("B", len(blocks) - 1))
+                cur = []
+            order.append(("L", t[1]))
+    if cur:
+        blocks.append(cur)
+        order.append(("B", len(blocks) - 1))
+    rows = {}
+    if not labels:
+        # a table for one slot only ("given to parties other than subsidiaries ...")
+        want = "B" if re.search(r"other than|others|any other", intro, re.I) else (
+            "A" if _SLOT_A.search(intro) else None)
+        if want is None or want != slot or len(blocks) != 1 or len(blocks[0]) != nc:
+            return None
+        rows[slot] = blocks[0]
+    elif len(blocks) == 1 and len(blocks[0]) == nc * len(labels) and order[0][0] == "L" \
+            and all(o[0] == "L" for o in order[:len(labels)]):
+        for k, lab in enumerate(labels):            # labels first, then the cells row by row
+            rows[lab] = blocks[0][k * nc:(k + 1) * nc]
+    elif len(blocks) == len(labels):
+        for lab, blk in zip(labels, blocks):        # one block per label, in order
+            rows[lab] = blk
+    else:
+        last = None
+        for o in order:                             # each block to the label printed before it
+            if o[0] == "L":
+                last = o[1]
+            elif last is not None:
+                rows[last] = blocks[o[1]]
+            else:
+                return None
+    if slot not in rows and labels and slot in labels:
+        return [], "iii_a_table: no figure on this row"
+    if slot not in rows:
+        return None
+    cells = rows[slot]
+    if len(cells) != nc:
+        return None
+    loans = [c[0] for c, k in zip(cells, cols) if k == "loan" and c[2] and (_num(c[0]) or 0) > 0]
+    guar = [c[0] for c, k in zip(cells, cols) if k == "guarantee" and c[2] and (_num(c[0]) or 0) > 0]
+    if loans:
+        return loans, "iii_a_table: balance outstanding, funded loans" + (" (guarantee not added)" if guar else "")
+    if guar:
+        return guar, "iii_a_table: balance outstanding, guarantees (no loan printed)"
+    return [], "iii_a_table: no figure on this row"
+
+
+# ---------------------------------------------------------------------------
+# (ii)(b) differences
+# ---------------------------------------------------------------------------
+def ii_b_difference(text: str, positions: list):
+    """The difference the auditor prints between the books and the quarterly statements. Returns
+    (printed, note) or None. Table with a 'difference' column: the year-end (March) quarter, else the
+    largest. Prose: 'a difference of Rs. X' wins; else two balances (books vs statement) -> their
+    difference is left to the caller (None here)."""
+    for p in positions:
+        if p is None or p < 0:
+            continue
+        t = _header_and_rows(text, p)
+        if not t or "difference" not in t["kinds"]:
+            continue
+        di = t["kinds"].index("difference")
+        best, pick = None, None
+        for r in t["rows"]:
+            if len(r["cells"]) != len(t["kinds"]) or not r["cells"][di][2]:
+                continue
+            c = r["cells"][di]
+            if re.search(r"\bmar(?:ch)?\b", r["label"], re.I):
+                return c[0], c[1], "ii_b: difference of the year-end quarter"
+            v = _num(c[0]) or 0
+            if best is None or v > best:
+                best, pick = v, c
+        if pick:
+            return pick[0], pick[1], "ii_b: largest quarterly difference (no year-end row)"
+    return None
+
+
+# ---- figure checks used by compute() / apply_amounts() ----------------------
+
+_THRESHOLD_BEFORE = re.compile(r"(?:in\s+excess\s+of|exceed\w*|more\s+than|above)\s*(?:rs\.?|₹|inr|\?)?\s*\.?\s*$", re.I)
+_OPENING_WORDS = re.compile(r"beginning of the (?:year|period|financial year)|opening balance|brought forward", re.I)
+_YEAR_END_WORDS = re.compile(r"year[\s-]*end|closing|as at|as on|balance sheet date|outstanding at the end|continue to remain", re.I)
+_BALANCE_BEFORE = re.compile(r"\bbalances?\b|\boutstanding (?:balance|as on)\b", re.I)
+_DEFAULT_WORDS = re.compile(r"overdue|not paid|unpaid|default(?:ed)?\s+(?:of|amount|in\s+(?:the\s+)?(?:re)?payment\s+of\s+(?:rs|₹))"
+                            r"|\bnpa\b|non[- ]performing|delay|amount not paid", re.I)
+_UNDISPUTED_SENT = re.compile(r"\bundisputed\b|in arrears\b[^.]{0,120}six months|for a period of more than six months", re.I)
+_DISPUTE_SENT = re.compile(r"(?<!un)disput|\bforum\b|pending before|appellate|tribunal", re.I)
+_GUAR_CTX = re.compile(r"guarantee", re.I)
+_UNIT_PREV = re.compile(r"\d[\d,]*(?:\.\d+)?\s*(" + _UNIT_WORD + r")\b[^.]{0,120}$", re.I)
