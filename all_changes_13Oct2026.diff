+"""PATCH 13-Oct-2026 (P13) - one-minute check that the vLLM server enforces a text-field length limit
+(JSON schema "maxLength") under guided JSON. Run once before the next two-call run:
+
+    python tools/check_vllm_maxlength.py
+
+It reads the same .env settings as run.py (LLM_BACKEND, LLM_BASE_URL, LLM_MODEL, LLM_GUIDED_JSON) and sends ONE
+small request whose field is limited to 40 characters while the model is asked to write about 400.
+
+  PASS   - the reply field is 40 characters or less: the P13 loop limit works on this server.
+  FAIL   - the field is longer: this server ignores maxLength. P13 then has no effect (nothing breaks); the old
+           cut-off salvage still applies. Tell Claude, so the code-side stop is used instead.
+No client data is sent.
+"""
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+try:
+    from dotenv import load_dotenv          # optional, as in run.py
+    load_dotenv()
+except Exception:                            # noqa: BLE001
+    pass
+from caro.cin_pipeline import default_client_kwargs   # noqa: E402
+from caro.llm import make_client                      # noqa: E402
+
+LIMIT = 40
+schema = {"title": "maxlength_check", "type": "object",
+          "properties": {"text": {"type": "string", "maxLength": LIMIT}}, "required": ["text"]}
+backend, kw = default_client_kwargs()
+kw["max_tokens"] = 400
+client = make_client(backend, **kw)
+raw = client.chat("Return JSON only.", 'Return {"text": "..."} where text is the sentence "The quick brown fox jumps '
+                  'over the lazy dog." written ten times.', schema=schema)
+try:
+    val = json.loads(raw).get("text", "")
+except Exception:                            # noqa: BLE001
+    print("Could not read the reply as JSON - first 300 characters:\n", (raw or "")[:300])
+    sys.exit(2)
+print(f"field length: {len(val)} (limit {LIMIT})")
+print("PASS - maxLength is enforced; P13 is active." if len(val) <= LIMIT
+      else "FAIL - this server ignores maxLength; P13 has no effect here (nothing breaks).")
+sys.exit(0 if len(val) <= LIMIT else 1)
