+def _sentence_before(full_text: str, pos: int, span: int = 900) -> str:
+    """The text from the start of the last running sentence before pos up to pos. For a table cell this
+    reaches back over the header and rows to the sentence that introduces the table."""
+    seg = full_text[max(0, pos - span):pos]
+    line = seg[seg.rfind("\n") + 1:]
+    if len(re.findall(r"[A-Za-z]{2,}", line)) >= 8:   # the figure sits in a running sentence: that sentence
+        lb = [m.end() for m in re.finditer(r"\.\s+(?=[A-Z(])", line)]
+        return line[lb[-1]:] if lb else line
+    bounds = [m.end() for m in re.finditer(r"\.\s+(?=[A-Z(•\-])", seg)]
+    for b in reversed(bounds):
+        part = seg[b:]
+        if any(len(re.findall(r"[A-Za-z]{2,}", ln)) >= 8 for ln in part.split("\n")):
+            return part
+    return seg
+
+
+def _sentence_after(full_text: str, pos: int, span: int = 300) -> str:
+    seg = full_text[pos:pos + span]
+    m = re.search(r"\.\s+(?=[A-Z(])|\n\s*\n", seg)
+    return seg[:m.start()] if m else seg
+
