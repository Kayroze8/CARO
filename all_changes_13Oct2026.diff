+def _staged_item_checks(uid: str, ed: int, kept: list, where: list, heads: list, unclear: list,
+                        full_text: str, notes: list, rec: dict):
+    """PATCH 13-Oct-2026: drop figures that cannot count, by the auditor's own table / sentence."""
+    u = uid.lower()
+    keep = []
+    kinds = []
+    for i, ((printed, v), (pos, note_txt)) in enumerate(zip(kept, where)):
+        kind = cell_kind(full_text, pos) if (pos >= 0 and amt_switch_on("TABLE_COLUMNS")) else None
+        kinds.append(kind)
+        num = (_FIG.search(str(printed)) or _FIG.search("0")).group("num")
+        after = full_text[pos + len(num): pos + len(num) + 30] if pos >= 0 else ""
+        before = full_text[max(0, pos - 160):pos] if pos >= 0 else ""
+        sent = (_sentence_before(full_text, pos) + _sentence_after(full_text, pos)) if pos >= 0 else ""
+        why = None
+        own_src = rec.get("_clause_src") or ""
+        other_src = rec.get("_other_src") or ""
+        digits_ = re.sub(r"\D", "", num)
+        if amt_switch_on("OWN_CLAUSE_ONLY") and own_src and other_src and len(digits_.lstrip("0")) >= 4 \
+                and not appears_in(printed, own_src) and appears_in(printed, other_src):
+            # the figure is printed in another clause's passage and not in this one (Ichalkaranji 2022-23:
+            # the (v) deposits figure "Rs. 7383 thousand" taken as the (vii)(a) arrears amount)
+            why = "figure_of_another_clause"
+        elif amt_switch_on("NOT_MONEY") and (_AREA.search(str(printed)) or _AREA.match(after.strip()[:12] or "x-x")
+                                    or re.match(r"\s*(?:acres?|hectares?|ghunt\w*|guntha|sq)", after, re.I)):
+            why = "area_not_money"
+        elif amt_switch_on("NOT_MONEY") and pos >= 0 and _THRESHOLD_BEFORE.search(before[-40:]) \
+                and v is not None and abs(v - 5e7) < 1 and re.search(r"working\s+capital|sanction", sent, re.I):
+            why = "threshold_not_amount"
+        elif kind in ("paid",):
+            why = "paid_under_protest_column"
+        elif kind in ("opening", "prior"):
+            why = kind + "_column"
+        elif kind in ("flow", "not_last") and u in LOANISH[ed]:
+            why = "during_the_year_column"
+        elif amt_switch_on("OPENING_PROSE") and kind is None and u in LOANISH[ed] and pos >= 0 and len(kept) > 1:
+            ctx = full_text[max(0, pos - 160):pos]
+            lastnum = list(re.finditer(r"\d[\d,]*\.?\d*\s*(?:" + _UNIT_WORD + r")?", ctx))
+            ctx = ctx[lastnum[-1].end():] if lastnum and lastnum[-1].end() < len(ctx) - 1 else ctx
+            mo = list(_OPENING_WORDS.finditer(ctx))
+            if mo and not _YEAR_END_WORDS.search(ctx[mo[-1].end():]) \
+                    and not re.search(r"includ\w*\s+(?:the\s+)?(?:opening|balance)", ctx, re.I):
+                why = "opening_balance"
+        if why is None and amt_switch_on("BALANCE_NOT_DEFAULT") and u in DEFAULT_UNITS[ed] and pos >= 0 \
+                and _BALANCE_BEFORE.search(full_text[max(0, pos - 110):pos]) and not _DEFAULT_WORDS.search(sent):
+            why = "loan_balance_not_a_default"
+        if why is None and amt_switch_on("UNDISPUTED_IN_VII_B") and u == "vii_b" and pos >= 0 \
+                and not _in_disputed_table(full_text, pos):
+            sb = _sentence_before(full_text, pos) + _sentence_after(full_text, pos)
+            if _UNDISPUTED_SENT.search(sb) and not _DISPUTE_SENT.search(re.sub(r"(?i)undisputed", "", sb)):
+                why = "undisputed_arrears_belong_to_vii_a"
+                rec.setdefault("_undisputed_moved", []).append((printed, v))
+        if why:
+            notes.append(why + ": " + str(printed))
+            continue
+        # "Rs.1009 thousand and total outstanding balance Rs.9563": the unit of the sentence
+        if amt_switch_on("UNIT_CARRY") and pos >= 0 and v is not None:
+            fm = _FIG.search(str(printed))
+            if fm and not fm.group("unit") and not fm.group("dash") and "," not in fm.group("num") \
+                    and "." not in fm.group("num") and currency_before(full_text, pos) \
+                    and not inline_unit(full_text, pos, fm.group("num")) and heads[i] == 1.0:
+                seg = re.sub(r"(?:rs\.?|₹|inr|\?)\s*\.?\s*$", "", full_text[max(0, pos - 150):pos], flags=re.I)
+                mprev = _UNIT_PREV.search(seg)
+                if mprev:
+                    v = v * _mult(mprev.group(1))
+                    notes.append("unit_carried_from_sentence: " + str(printed))
+        keep.append(i)
+        kept[i] = (printed, v)
+    nk = [kept[i] for i in keep]
+    nw = [where[i] for i in keep]
+    nh = [heads[i] for i in keep]
+    nkind = [kinds[i] for i in keep]
+    # LOAN VS. GUARANTEE (approved rule): a guarantee is never added to a funded loan
+    if u in LOANISH[ed] and len(nk) > 1:
+        g = [j for j, (p, n) in enumerate(nw)
+             if nkind[j] == "guarantee" or _GUAR_CTX.search(n or "") or (p >= 0 and _GUAR_CTX.search(full_text[max(0, p - 60):p]))]
+        if g and len(g) < len(nk):
+            notes.append("guarantee_not_added_to_loan: " + ", ".join(nk[j][0] for j in g))
+            nk = [x for j, x in enumerate(nk) if j not in g]
+            nw = [x for j, x in enumerate(nw) if j not in g]
+            nh = [x for j, x in enumerate(nh) if j not in g]
+    nu = [x for x in unclear if x in {k for k, _ in nk}]
+    return nk, nw, nh, nu
