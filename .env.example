# Copy this file to .env and fill in your values. .env is loaded
# automatically by run.py (via python-dotenv) - no export needed.

# ---- S3: where CIN filing zips live -----------------------------------
BUCKET_NAME=ews-data-storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ---- LLM server (used by --cin mode, and as CLI flag defaults) --------
# backend: ollama | openai | vllm | transformers | mock
LLM_BACKEND=vllm
LLM_MODEL=Qwen/Qwen3.5-9B
# vLLM/OpenAI-compatible server URL (matches your `vllm serve ... --port 9001`)
LLM_BASE_URL=http://localhost:9001/v1
# OUTPUT token budget per LLM call — NOT the context window. The model's limit
# (--max-model-len, e.g. 65536) covers prompt + reply; when this setting does not
# fit a long prompt, the code trims it for that one call and logs
# "reply allowance for this call: N tokens" (INFO; a WARNING only below 16,000).
# The two-call flow's Call 1 returns about 10,000-15,000 tokens on a long filing,
# so do NOT set 4096 there. 35000 lets the code use whatever room each call has.
LLM_MAX_TOKENS=35000
LLM_THINK=false
LLM_GUIDED_JSON=true
LLM_BATCH_SIZE=3
# Phase 2 (09-Oct-2026, Option A): which LLM flow to use. single = today's one call per
# filing (default, the rollback). staged = two calls (Call 1 places the auditor's text
# under each CARO clause; Call 2 checks that mapping by subject and classifies); any
# problem falls back to the single call for that filing. Keep "single" until the
# Phase 2 gate passes.
# The staged calls need structured output on the server: set
# LLM_STRUCTURED_OUTPUT=response_format if vLLM ignores guided_json (N4).
# Test mode: staged_nofallback = two calls only, never the single call; a check that would
# normally send a filing back to the single call is only written to the audit file
# (llm_reply.staged.would_fall_back). Use it to inspect the two-call result itself;
# do not use it for client output.
CARO_LLM_FLOW=single

# ---- local working directories for --cin mode --------------------------
CIN_DOWNLOAD_DIR=./cin_downloads
CIN_EXTRACT_DIR=./cin_extracted
# Set true to keep the downloaded zip + extracted files after each --cin
# run (useful for debugging). Default: cleaned up automatically (temp dir).
CIN_KEEP_FILES=false

# ---- logging -------------------------------------------------------------
# Folder for log files (created automatically if missing). Every run
# writes one timestamped file here, in addition to the usual console output.
LOG_DIR=./logs
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Set true to turn logging off completely: no logs/ folder, no file, no
# console log lines. The final JSON result is still printed/written as
# normal — this only silences the progress/status logging. Same as
# passing --no-log on the CLI.
LOG_DISABLE=false


# ---- OCR (Non-XBRL / scanned filings) -----------------------------------
# Master switch. false = scanned pages are skipped instead of OCR'd.
OCR_ENABLED=true
# tesseract (default, CPU, no model download) | paddleocr (stronger on poor
# scans and tables; uses GPU when paddlepaddle-gpu is installed)
# tesseract | paddleocr. paddleocr is optional: if it cannot be loaded — not
# installed, a PaddleX re-initialisation error, a CUDA mismatch — the pipeline
# logs a warning once and uses tesseract for the rest of the run rather than
# failing the filing.
#
# Note on accuracy: on MCA scans the limiting factor is usually the source
# scan, not the engine. Measured on one filing, re-rendering at 400 DPI
# instead of 200 recovered one extra clause marker out of six; the brackets
# around markers are degraded in the paper original. Bracket repair in
# annexure.repair_ocr_markers addresses that directly and costs nothing.
OCR_BACKEND=tesseract
# auto | cpu | gpu   (PaddleOCR only; "auto" uses GPU if the build supports it)
OCR_DEVICE=auto
OCR_LANG=eng
# Rasterisation DPI. 200 is the accuracy/speed knee for MCA scans.
OCR_DPI=200
# A page with fewer than this many non-space characters is treated as an image.
OCR_MIN_CHARS_PER_PAGE=180
# Minimum fraction of "clean" tokens before a text layer is trusted. Filings
# scanned with a poor OCR engine embed unusable text; below this they're re-OCR'd.
OCR_MIN_CLEAN_TOKEN_RATIO=0.55

# Second garble signal: share of tokens that are very common English words.
# Token SHAPE alone is too permissive — a page reading "ANNEXURE TO TIIE
# INDEPENOENI AUDITORS' REPORT" scores 0.68 clean because those are letter-only
# tokens. Common-word density separates far better: real auditor prose runs
# 0.30-0.38, that page runs 0.16. Below this the embedded text layer is
# re-OCR'd from the page image. Only applies to pages that carry a sizeable
# image, so clean native pages are never affected.
OCR_MIN_COMMON_WORD_RATIO=0.24

# Process Non-XBRL (AOC-4) filings alongside XBRL ones. false = XBRL only
# (the previous behaviour).
# Whether Non-XBRL (scanned AOC-4) filings are processed at all.
#
# false does two things, from this ONE setting:
#   * discovery skips Non-XBRL files entirely, so they are never downloaded,
#     unzipped or OCR'd — nothing is paid for a filing that will be refused;
#   * extraction refuses any Non-XBRL source that reaches it by another route
#     (a direct run_pipeline() call, an unusually named file), so there is no
#     way for one to slip through.
#
# A refused filing returns status="Failed" with the reason in
# metadata.error. `result` stays EMPTY — it describes what the auditor
# reported, and a filing that was never read supports no such claim.
#
# A CIN whose bundle is entirely Non-XBRL fails with a message saying so,
# rather than the misleading "CIN not found". A mixed bundle still processes
# its XBRL years normally.
CIN_INCLUDE_NONXBRL=true

# Process only the N most recent FINANCIAL YEARS per CIN. Unset, 0 or a
# negative value means all years.
#
# The limit counts distinct financial years, not documents. A company can file
# the same year twice (an original and a revision), and those are different
# files with different names, so neither the filename nor a content hash tells
# them apart — only the financial year inside the document does. When two
# filings cover the same year the more recently filed one is kept and the other
# is skipped; metadata reports this as duplicate_year_filings_skipped.
#
# Candidates are ordered by the MCA filing date in the filename, falling back
# to file mtime. Overridable per call: --max-years on the CLI, "max_years" in
# the API body.
CIN_MAX_YEARS=5

# When two filings for the same financial year are found in a bundle (an
# original and a revision, or simply two uploads), the year limit above
# counts them as ONE year, keeping the more recently filed document. This is
# normally decided from the financial_year each filing resolves to, but if
# one of them fails to resolve a year at all (typically a rescanned
# resubmission with worse OCR than the original), there is nothing to compare
# by value. In that case filing-date PROXIMITY decides: filings within this
# many days of one another are presumed to be the same year, since real
# consecutive financial years are filed roughly a year apart while a same-year
# revision is filed days to a few months after the original.
CIN_DUPLICATE_WINDOW_DAYS=120

# ---- Document source -----------------------------------------------------
# Where filing PDFs come from: local | s3
# If unset, inferred as "local" when CIN_FOLDER_PATH is set, else "s3".
CIN_SOURCE=local

# [local] Root folder holding already-extracted CIN folders. Read-only:
# the pipeline never copies, moves or deletes anything under here.
# Layouts supported:
#   <root>/<CIN>/Annual Returns and Balance Sheet eForms/...
#   <root>/<anything>/<CIN>/Annual Returns .../...
#   <root>/<CIN>.zip  (unpacked to temp; the archive itself is left alone)
CIN_FOLDER_PATH="/opt/stuff/bir-storage/mca_data/"

# ---- API -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ---- Result cache --------------------------------------------------------
# The BIR (CARO_clauses) and trigger (CARO_ews) sections are two projections
# of ONE extraction run, but they are fetched by DIFFERENT PROCESSES:
#     POST /caro/extract  -> uvicorn process
#     run.main_ews(cin)   -> your process
# so the cache is on disk. Without it the second call re-runs OCR and every
# LLM batch, and the two sections can disagree.
RESULT_CACHE_ENABLED=true

# IMPORTANT: use an ABSOLUTE path. The default is relative, so if uvicorn and
# your calling script run from different working directories they would
# silently use different caches and get no reuse. Both processes need write
# access to this directory.
RESULT_CACHE_DIR=/var/lib/caro_pipeline/cache

# Seconds an entry stays reusable. Short on purpose: source documents may be
# replaced, and serving a stale extraction as fresh is worse than re-running.
RESULT_CACHE_TTL=900

# Max cached CINs, oldest evicted first. Entries hold full evidence text.
RESULT_CACHE_MAX=64

# Seconds to wait when another process is already extracting this CIN. The
# waiter then reuses that result instead of duplicating the work. Set to 0 to
# never wait (each caller runs its own extraction).
RESULT_CACHE_LOCK_WAIT=1800

# ---- Unable-to-Comment reduction -----------------------------------------
# Resolve predictable evidence gaps to "Not Applicable" using facts already in
# the same filing (private company -> no IPO proceeds; "intangible" absent
# everywhere -> no intangible-asset records; "Nidhi" absent -> not a Nidhi
# company). Every resolution is marked derived_from_document=true and states
# its premise. Findings (qualified/adverse) are never touched.
# Set false to disable and report every gap as unevidenced.
GAP_RESOLVER_ENABLED=true

# ---- Evidence-gap labelling ----------------------------------------------
# An evidence gap (internally insufficient_evidence) is displayed as one of
# three labels, chosen by clause_confidence:
#
#   clause_confidence <  threshold  -> "Human Review Required"
#        the model could not classify the unit reliably. In practice: it HAD
#        text and failed to resolve it (0.40), or a sub-clause contradicts its
#        parent (0.30).
#   clause_confidence >= threshold  -> "Neutral"
#        the auditor simply did not write about this point (0.70). A confident
#        reading, and not work for anybody.
#   nothing under the clause evidenced at all -> "Unable to Comment"
#
# The decision is on CONFIDENCE, not on how important the clause is. Raise the
# threshold to route more gaps to review; lower it to route fewer.
REVIEW_CONFIDENCE_THRESHOLD=0.5

# Each refinement of "Unable to Comment" can be switched off independently.
# false = that case is reported as "Unable to Comment" instead; the other
# label keeps working. With BOTH false the output uses only the original five
# classifications, which is what a consumer that predates the split expects.
#
#   CARO_LABEL_REVIEW=false    no "Human Review Required" — low-confidence
#                              gaps show as "Unable to Comment"
#   CARO_LABEL_NEUTRAL=false   no "Neutral" — gaps where the auditor was
#                              simply silent show as "Unable to Comment"
#
# Display only. review_required in CARO_quality, severity roll-up and the EWS
# colour codes are computed from the internal code and do not change, so
# turning a label off hides it from the output without altering which units
# are actually routed for review.
CARO_LABEL_REVIEW=true
CARO_LABEL_NEUTRAL=true

# ---- XBRL clause extraction ----------------------------------------------
# XBRL ONLY. Hand the located CARO annexure text to the model and let it
# assign each passage to an official clause, instead of splitting the text
# with regexes over the auditor's numbering.
#
# Why: the numbering is the least reliable thing in these filings. Auditors
# renumber, merge and skip clauses, and any formatting change breaks a
# regex split — which then cascades, because a clause that swallows its
# neighbour's text batches wrongly and the next batch has nothing to
# classify. Subject matter does not move: clause (ii) is about inventory
# whatever it is numbered.
#
# Safe by construction: marker parsing still runs first, and the LLM result
# is adopted ONLY if it recovers more clauses. A model failure, a truncated
# reply or a bad JSON parse therefore falls back to the previous behaviour
# rather than losing the filing. Clause identity always comes from the
# official catalogue — ids the model invents are dropped.
#
# Non-XBRL is unaffected and continues to use marker-based parsing.
XBRL_LLM_CLAUSE_EXTRACTION=true
