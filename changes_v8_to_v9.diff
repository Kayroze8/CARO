+                g, rid = None, None
+                if ed == 2020 and uid == "i_c" and lab == "FAV" and _patch_on("V9_IC_NOPROP"):
+                    m = _V9_NOPROP.search(own_a)
+                    if m and not re.search(r"\bexcept\b|\bhowever\b|\bbut\b", own_a, re.I):
+                        g, rid = ("NA", own_a.strip()[:300]), "IC"
