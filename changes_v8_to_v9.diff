+# ===========================================================================
+# PATCH 15-Oct-2026 (v9). Fixes 1-4 approved by Toby on 15 Oct 2026 (audit of the 14/15-Oct run, 42 CINs).
+# Code only, after the model, two-call records only. Each has its own switch in staged_llm.PATCH_SWITCHES;
+# all off = v8 output. Never changes an Adverse or an Auditor Unable to Verify (except F1/F2/4b, which act
+# inside the Adverse triggers). Every change is in the audit file (v9_rule / v9_vii_passage / v9_delay_not_escalated).
+#   F1  V9_QSTRIP       the printed CARO question ("Whether the company has incurred cash losses ...") is not read
+#                       by the Adverse triggers (Eleanor 2023-24 / 2024-25: 6 false Adverse labels)
+#   F2  V9_VII_PASSAGE  (vii)(a) arrears / (vii)(b) disputed dues read from the whole (vii) passage, bounded at
+#                       (viii), lines rejoined, sibling text removed (Committed 2022-23, Starlite 2020-21, Mbook 2024-25)
+#   3a  V9_IC_NOPROP    (i)(c) "does not hold any immovable property" -> Not Applicable
+#   3b  V9_G2_HEADER    v7 G2 empty exception table: header words were not removed (regex bug), "NA" bodies missed
+#   3c  V9_D3_DISCLOSED (iii)(a) loans given, details "disclosed in the financial statements", no figure -> Qualified (D-3)
+#   3d  V9_BLANKET_GATE blanket NA only from a sentence that covers the whole clause (N2 test on the label branch)
+#   4a  V9_D1C          (vii)(a) "generally regular", no delay, and the arrears question unanswered anywhere in (vii)
+#                       -> Qualified (Toby 15-Oct)
+#   4b  V9_DELAY_QUAL   (ix)(a) a delay made good ("not defaulted ... except some delay", "paid on ...") -> Qualified;
+#                       "has defaulted" / NPA / unpaid stays Adverse (Toby 15-Oct)
+# ===========================================================================
+_V9_Q = re.compile(r"(?:^|(?<=[.;:\n]))\s*(?:\(?[ivx]+\)?\s*)?(?:\(?[a-z]\)\s*)?(?:\([a-z]\)\s*)?"
+                   r"(?:(?!\b(?:we|our|us)\b)[^.;\n]){0,80}?\bwhether\b[^;?\n]*(?:[;?]|$)", re.I)
+
+
+def strip_printed_questions(t: str) -> str:
+    """The text without the printed CARO question(s) (question-and-answer table layouts)."""
+    return _V9_Q.sub(" ", t or "")
+
+
+_V9_VII_END = re.compile(r"\n\s*(?:\(?viii\)?[.)]|8\.)|unrecorded\s+income|previously\s+unrecorded|surrendered\s+or\s+disclosed|"
+                         r"\[MCA_BOX:(?![^\]]*(?:statutory\s+dues|regularity))", re.I)
+_V9_DISPUTE_CTX = re.compile(r"on\s+account\s+of\s+(?:any\s+)?disput|dispute\s+is\s+pending|under\s+dispute", re.I)
+
+
+def _v9_norm(t: str) -> str:
+    return re.sub(r"\s+", " ", t or "").strip()
+
+
+_V9_VII_START = re.compile(r"(?:^|\n)[ \t]*(?:\(\s*vii\s*\)|vii\s*[.)]|7\s*[.)])|\[MCA_BOX:[^\]]*(?:statutory\s+dues|regularity)|"
+                           r"in\s+respect\s+of\s+statutory\s+dues", re.I)
+
+
+_V9_VII_ANCHOR = re.compile(r"undisputed\s+(?:statutory\s+)?dues|in\s+respect\s+of\s+statutory\s+dues|regular(?:ly)?\s+(?:in\s+)?deposit|"
+                            r"statutory\s+dues[^.]{0,200}(?:regular|deposited)", re.I)
+
+
+def vii_passage(main: dict, caro_text: str, subs: Optional[list] = None) -> str:
+    """The (vii) passage(s) of the annexure, found by subject (not by the model's quotes, whose generic opening
+    words can match another clause): every place the statutory-dues answer starts, from the clause's number /
+    MCA box / sentence start to the start of (viii), wrapped lines joined. Several copies (MCA box + narrative)
+    are all kept."""
+    t = caro_text or ""
+    segs, last_end = [], -1
+    for m in _V9_VII_ANCHOR.finditer(t):
+        if m.start() < last_end:
+            continue
+        back = t[max(0, m.start() - 600):m.start()]
+        ms = list(_V9_VII_START.finditer(back))
+        if ms:
+            s0 = max(0, m.start() - 600) + ms[-1].start()
+        else:
+            k = max(back.rfind("\n\n"), back.rfind(". "))
+            s0 = max(0, m.start() - 600) + (k + 1 if k >= 0 else 0)
+        seg = t[s0:s0 + 4000]
+        e = _V9_VII_END.search(seg, (m.start() - s0) + 150)
+        if e:
+            seg = seg[:e.start()]
+        last_end = s0 + len(seg)
+        segs.append(seg)
+    reg = strip_labels("\n\n".join(segs))
+    reg = re.sub(r"(?<![.:;])\s*\n\s*(?=[a-z0-9,(])", " ", reg)
+    return strip_printed_questions(reg) if _patch_on("V9_QSTRIP") else reg
+
+
+def vii_passage_hit(uid: str, main: dict, subs: list, rec: dict, caro_text: str):
+    """(rule, sentence) when the (vii) passage states undisputed arrears over six months ((vii)(a)) or a disputed-dues
+    table with an amount ((vii)(b)); None otherwise."""
+    reg = vii_passage(main, caro_text, subs)
+    if not reg:
+        return None
+    other = "vii_b" if uid == "vii_a" else "vii_a"
+    sib = ""
+    for s in subs:
+        if s is not rec and _unit_id(s, "sub", "vii").lower() == other:
+            sib = _v9_norm(strip_labels(real_text((s.get("normalized_fields") or {}).get("source_text")) or ""))
+    p2 = _v9_norm(reg)
+    if len(sib) >= 20:
+        p2 = p2.replace(sib, " ")
+    if uid == "vii_a":
+        for rule in (R_ARREARS, R_ARREARS_LISTED):
+            h = rule.hit(reg)
+            if h and not re.search(r"(?<!un)disput", h, re.I) and _v9_norm(h)[:40] in p2:
+                return rule, h
+        return None
+    h = R_DISPUTED.hit(reg)
+    if h:
+        k = reg.find(h[:60])
+        if _V9_DISPUTE_CTX.search(reg[max(0, k - 800):k + 200]) and not re.search(r"default|intimation", h, re.I):
+            return R_DISPUTED, h
+    return None
+
+
+_V9_HARD_DEFAULT = re.compile(r"\bhas\s+defaulted|\bhave\s+defaulted|\bNPA\b|non[-\s]?performing|\bnot\s+(?:been\s+)?paid|\bunpaid|"
+                              r"\birr+egular|not\s+(?:been\s+)?regular|outstanding\s+as\s+(?:at|on)|still\s+outstanding|"
+                              r"wil+ful\s+defaulter\s+(?!.{0,20}\bnot)", re.I)
+_V9_DELAY = re.compile(r"\bdelay", re.I)
+
+
+def minor_delay_only(sentence: str, text: str) -> bool:
+    """Toby 15-Oct (4b): the auditor reports only a delay that was made good."""
+    return bool(_V9_DELAY.search(sentence or "")) and not _V9_HARD_DEFAULT.search(text or "") \
+        and not _V9_HARD_DEFAULT.search(sentence or "")
+
+
+_V9_NOPROP = re.compile(r"(?:does|do|did)\s*(?:not|n['’]t)\s+(?:have|hold|own|possess)\s+any\s+immovable\s+propert|"
+                        r"not\s+(?:having|holding|owning)\s+any\s+immovable\s+propert|\bno\s+immovable\s+propert|"
+                        r"(?:does|do)\s*(?:not|n['’]t)\s+hold\s+any\s+(?:freehold\s+)?(?:land|title\s+deeds)", re.I)
+_V9_DISCLOSED = re.compile(r"disclosed\s+in\s+(?:the\s+)?(?:standalone\s+)?(?:financial\s+statements?|notes?\s+to)|refer\s+note", re.I)
+_V9_LOAN_GIVEN = re.compile(r"aggregate\s+amount\s+of\s+(?:the\s+)?(?:loans?|advances?|guarantees?)|"
+                            r"(?:has|have)\s+(?:also\s+)?(?:granted|provided|given|made|advanced|stood)", re.I)
+_V9_D1C_BAD = re.compile(r"\bexcept\b|\bhowever\b|\bbut\b|\bdelay|\bnot\s+(?:been\s+)?(?:regular|deposited|paid)|\birregular|"
+                         r"\bdefault|\bvariation", re.I)
+_V9_HEDGE = re.compile(r"\bgenerally\s+(?:been\s+)?(?:deposited\s+)?regular", re.I)
+_V9_ARREARS_ANSWERED = re.compile(
+    r"\bno\b[^.]{0,80}?\b(?:amounts?|dues|arrears|sums?)\b[^.]{0,300}?(?:six|6)\s+months|"
+    r"\b(?:not|nor)\s+(?:have|had|has)\s+any\b[^.]{0,80}?\b(?:amounts?|dues|arrears)\b[^.]{0,250}?(?:six|6)\s+months|"
+    r"\bno\s+arrears\b|not\s+(?:been\s+)?outstanding[^.]{0,120}(?:six|6)\s+months|"
+    r"\b(?:there\s+)?(?:is|are|were|was)\s+no\s+(?:statutory\s+)?dues\b|\bno\s+dues\s+(?:as\s+on|outstanding)", re.I)
+
+
+def _v9_arrears_answered(passage: str) -> bool:
+    passage = re.sub(r"\s+", " ", passage or "")
+    for s in _sentences(passage):
+        if _V9_ARREARS_ANSWERED.search(s) and not re.search(r"(?<!un)disput", s, re.I):
+            return True
+    # a stray full stop inside the auditor's sentence ("Goods and Service Tax. Customs Duty ... six months"): read a
+    # short window across it. Lenient on purpose -- reading "answered" here can only keep today's label.
+    for m in re.finditer(r"\bno\s+(?:undisputed\s+)?(?:amounts?|dues|arrears)\b", passage, re.I):
+        w = passage[m.start():m.start() + 450]
+        k = re.search(r"(?:six|6)\s+months", w, re.I)
+        if k and not re.search(r"(?<!un)disput", w[:k.end()], re.I):
+            return True
+    return any(rule.hit(passage) for rule in (R_ARREARS, R_ARREARS_LISTED))
+
+
+def v9_whole_clause(texts: list) -> Optional[str]:
+    """N2 whole-clause test (8-Oct) without requiring the word "any": one sentence that says nothing was made /
+    provided / granted / given, names the whole clause, and has no carve-out and no sub-point letter (b)-(h)."""
+    neg = re.compile(r"\bnot\s+(?:made|provided|granted|given|stood)\b", re.I)
+    for t in texts:
+        for s in _p1_sentences(t):
+            if not neg.search(s) or _BLANKET_PARTIAL.search(s) or _SUBPOINT_START.match(s):
+                continue
+            w = s.lower()
+            if _BLANKET_PARTIES.search(s) or all(k in w for k in ("investment", "guarantee", "security", "loan")):
+                return s
+    return None
+
+
+_V9_WHY = {"IC": "the company holds no immovable property, so (i)(c) does not arise (Fix 3a)",
+           "D3B": "loans are stated as given but the amounts are only 'disclosed in the financial statements' (D-3, Fix 3c)",
+           "D1C": "'generally regular' and the arrears question is not answered anywhere in clause (vii) (Toby 15-Oct, Fix 4a)",
+           "DQ": "a delay in repaying a lender that was made good; no default, NPA or unpaid amount (Toby 15-Oct, Fix 4b)"}
+
