+                    if _V9_DISCLOSED.search(own_a) and _V9_LOAN_GIVEN.search(own_a) and not _V8_AMOUNT.search(own_a) \
+                            and not re.search(r"\b(?:has|have)\s+not\b|\bno\s+(?:loans?|advances?)\b|\bnil\b", own_a, re.I):
+                        g, rid = ("QUAL", own_a.strip()[:300]), "D3B"
+                if g is None and uid == "vii_a" and lab == "FAV" and own and _patch_on("V9_D1C") and caro_text:
+                    if _V9_HEDGE.search(own_a) and not _V8_DELAY.search(own_a) and not _V9_D1C_BAD.search(own_a):
+                        passage = vii_passage(r, caro_text, subs) or own_a
+                        if not _v9_arrears_answered(passage):
+                            g, rid = ("QUAL", _V9_HEDGE.search(own_a).group(0) + " — " + own_a.strip()[:260]), "D1C"
+                if g is None and uid in (("ix_a",) if ed == 2020 else ("viii",)) and lab == "FAV" and own \
+                        and _patch_on("V9_DELAY_QUAL"):
+                    if re.search(r"\bexcept\b[^.]{0,160}\bdelay|\bdelay[^.]{0,120}\b(?:paid|repaid|regulari[sz]ed)", own_a, re.I) \
+                            and not _V9_HARD_DEFAULT.search(own_a):
