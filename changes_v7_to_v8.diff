+        if not isinstance(r, dict):
+            continue
+        main_id = str(r.get("main_clause_id", "")).strip().lower().strip("()")
+        subs = [s for s in (r.get("sub_clauses") or []) if isinstance(s, dict)]
+        mnf = r.get("normalized_fields") if isinstance(r.get("normalized_fields"), dict) else {}
+        main_src = strip_labels(real_text(mnf.get("source_text")) or "") if subs else ""
+        for rec, level in ([(s, "sub") for s in subs] or [(r, "main")]):
+            try:
+                if not rec.get("_staged"):
+                    continue
+                uid = _unit_id(rec, level, main_id).lower()
+                csr_ok = uid == "xx_b" and ed == 2020
+                keys = [k for k in _V8_KEEP_KEYS if rec.get(k)]
+                if keys and not (csr_ok and all(k in _V8_CSR_KEYS for k in keys)):
